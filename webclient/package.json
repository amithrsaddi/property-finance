{
  "name": "mortgage-manager-webclient",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/pages/*.ts --bundle --platform=browser --format=esm --outdir=public/pages",
    "dev:build": "npm run build -- --watch",
    "dev:serve": "http-server public -p 5173 -c-1 -e html",
    "dev": "concurrently \"npm run dev:build\" \"npm run dev:serve\"",
    "start": "http-server public -p 5173 -c-1 -e html",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.0",
    "http-server": "^14.1.1",
    "typescript": "^6.0.2"
  }
}
